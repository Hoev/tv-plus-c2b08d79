<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Top Bar with Back Button and Title -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/gradient_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <ImageButton
            android:id="@+id/exo_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/btn_secondary_focus_selector"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            android:tint="@color/gold_accent"
            android:padding="8dp"
            android:focusable="true"
            android:nextFocusRight="@id/exo_rew"
            android:nextFocusDown="@id/exo_rew" />

        <TextView
            android:id="@+id/exo_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Settings button for track selection -->
        <ImageButton
            android:id="@+id/exo_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/btn_secondary_focus_selector"
            android:contentDescription="Settings"
            android:src="@drawable/ic_settings"
            android:tint="@color/gold_accent"
            android:padding="8dp"
            android:focusable="true" />

    </LinearLayout>

    <!-- Center Controls (Play/Pause, Forward, Rewind) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Rewind 10s -->
        <ImageButton
            android:id="@id/exo_rew"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="32dp"
            android:background="@drawable/btn_secondary_focus_selector"
            android:contentDescription="Rewind 10 seconds"
            android:src="@drawable/ic_rewind_10"
            android:tint="@color/gold_accent"
            android:focusable="true"
            android:nextFocusLeft="@id/exo_back"
            android:nextFocusRight="@id/exo_play_pause" />

        <!-- Hidden TimeBar for ExoPlayer binding -->
        <androidx.media3.ui.DefaultTimeBar
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <!-- Large Gold Circular Play/Pause Button -->
        <ImageButton
            android:id="@id/exo_play_pause"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/btn_focus_selector"
            android:contentDescription="Play/Pause"
            android:src="@drawable/ic_play"
            android:tint="@android:color/black"
            android:padding="20dp"
            android:focusable="true"
            android:nextFocusLeft="@id/exo_rew"
            android:nextFocusRight="@id/exo_ffwd"
            android:nextFocusDown="@id/exo_progress" />

        <!-- Forward 10s -->
        <ImageButton
            android:id="@id/exo_ffwd"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="32dp"
            android:background="@drawable/btn_secondary_focus_selector"
            android:contentDescription="Forward 10 seconds"
            android:src="@drawable/ic_forward_10"
            android:tint="@color/gold_accent"
            android:focusable="true"
            android:nextFocusLeft="@id/exo_play_pause"
            android:nextFocusRight="@id/exo_pip" />

    </LinearLayout>

    <!-- Bottom Bar with Progress -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/gradient_bottom"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <!-- Time Bar (Gold Seekbar) -->
        <androidx.media3.ui.DefaultTimeBar
            android:id="@id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            app:played_color="@color/gold_accent"
            app:unplayed_color="#44FFFFFF"
            app:buffered_color="#88FFD700"
            app:scrubber_color="@color/gold_accent"
            app:scrubber_enabled_size="20dp"
            app:scrubber_disabled_size="12dp"
            app:bar_height="4dp"
            android:focusable="true"
            android:nextFocusUp="@id/exo_play_pause" />

        <!-- Time Display and Extra Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" / "
                android:textColor="#88FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:includeFontPadding="false" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- PiP Button -->
            <ImageButton
                android:id="@+id/exo_pip"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/btn_secondary_focus_selector"
                android:contentDescription="Picture in Picture"
                android:src="@drawable/ic_pip"
                android:tint="@color/gold_accent"
                android:padding="10dp"
                android:focusable="true"
                android:nextFocusLeft="@id/exo_ffwd" />

            <!-- Resize/Aspect Ratio Button -->
            <ImageButton
                android:id="@+id/exo_resize"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/btn_secondary_focus_selector"
                android:contentDescription="Resize"
                android:src="@drawable/ic_resize"
                android:tint="@color/gold_accent"
                android:padding="10dp"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>

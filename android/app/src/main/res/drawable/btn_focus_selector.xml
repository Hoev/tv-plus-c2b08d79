<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state - Gold glow with animated effect -->
    <item android:state_focused="true">
        <layer-list>
            <!-- Outer glow ring -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#66FFD700" />
                    <size android:width="104dp" android:height="104dp" />
                </shape>
            </item>
            <!-- Middle glow -->
            <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
                <shape android:shape="oval">
                    <solid android:color="#99FFD700" />
                </shape>
            </item>
            <!-- Inner gold circle -->
            <item android:left="10dp" android:top="10dp" android:right="10dp" android:bottom="10dp">
                <shape android:shape="oval">
                    <solid android:color="@color/gold_accent" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- Pressed state - Darker gold -->
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/gold_dark" />
        </shape>
    </item>
    
    <!-- Default state - Standard gold -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/gold_accent" />
        </shape>
    </item>
</selector>
